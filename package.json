{
  "name": "production",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "playwright test",
    "preview": "node tools/serve-export.mjs",
    "capture": "node tools/capture.mjs",
    "og": "node tools/og.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
