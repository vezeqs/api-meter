{
  "name": "production",
  "version": "1.0.5",
  "private": true,
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:unit && pnpm test:e2e && pnpm test:tools",
    "test:unit": "node --conditions=source --test \"tests/unit/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:tools": "node --test \"tests/tools/*.test.ts\"",
    "preview": "node tools/serve-export.mjs",
    "capture": "node tools/capture.mjs",
    "og": "node tools/og.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@production/shared": "workspace:*",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.10.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
