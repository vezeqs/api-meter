# Copy to .env and fill in real values. Never commit .env.
#
# Only variables that something actually reads belong here. Adding an
# integration means adding its variables in the same commit.

# Deployment coordinates for the static export.
# SITE_URL is the origin only; BASE_PATH is the subpath the project is served
# from. Both are inlined into the client bundle at build time.
NEXT_PUBLIC_SITE_URL=https://vezeqs.github.io
NEXT_PUBLIC_BASE_PATH=/api-meter

# Port for the Fastify service in apps/api.
API_PORT=4000

# Tool overrides. The Node tools read these from the process environment;
# they do not load `.env`, so export them in the shell when you need them.

# Host the static preview server binds to (default 127.0.0.1).
# HOST=127.0.0.1

# Host `pnpm capture` connects to (default 127.0.0.1). Set this when the
# preview server is reachable on another interface.
# CONNECT_HOST=127.0.0.1

# Port the static preview server listens on (default 4321).
# PORT=4321

# Subpath the preview server mounts the export under (default: the site's
# NEXT_PUBLIC_BASE_PATH, so the build and the preview agree). Explicit
# overrides for the tools use BASE_PATH.
# BASE_PATH=/api-meter

# Where `pnpm og` writes the card (default apps/web/public/og.png).
# OG_OUTPUT=apps/web/public/og.png
