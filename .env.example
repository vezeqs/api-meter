# Copy to .env and fill in real values. Never commit .env.
#
# Only variables that something actually reads belong here. Adding an
# integration means adding its variables in the same commit.

# Deployment coordinates for the static export.
# SITE_URL is the origin only; BASE_PATH is the subpath the project is served
# from. Both are inlined into the client bundle at build time.
NEXT_PUBLIC_SITE_URL=https://vezeqs.github.io
NEXT_PUBLIC_BASE_PATH=/api-meter

# Port for the Fastify service in apps/api.
API_PORT=4000
