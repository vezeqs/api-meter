# Copy to .env and fill in real values. Never commit .env.
# Every variable used by the app belongs here with a safe placeholder.

NODE_ENV=development

# Public base URL of the web app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Deployment coordinates for the static export. SITE_URL is the origin only;
# BASE_PATH is the subpath the project is served from.
NEXT_PUBLIC_SITE_URL=https://vezeqs.github.io
NEXT_PUBLIC_BASE_PATH=/api-meter

# Port for the API service.
API_PORT=4000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/production

# Auth
AUTH_SECRET=replace-with-a-32-byte-random-string
AUTH_URL=http://localhost:3000

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Observability
SENTRY_DSN=
